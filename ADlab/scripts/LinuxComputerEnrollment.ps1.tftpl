#Requires -Version 5.1
#Requires -RunAsAdministrator
#Requires -Modules ActiveDirectory, Az.Accounts, Az.KeyVault

<#
.SYNOPSIS
    Prestages Linux computer accounts in Active Directory and stores each
    newly generated computer-account password in Azure Key Vault.

.DESCRIPTION
    For each computer name supplied by Terraform:
      1. Ensure the target OU exists, creating the final OU level if needed.
      2. Check Active Directory for the computer sAMAccountName.
      3. If the computer already exists, skip it.
      4. Otherwise generate a password, create the enabled AD computer, and
         store the same password in Key Vault.
      5. If Key Vault storage fails, remove only the AD object created by this
         invocation.

    This template is compatible with Windows PowerShell 5.1.
#>

[CmdletBinding()]
param ()

Set-StrictMode -Version 2.0
$ErrorActionPreference = "Stop"

# Terraform renders COMPUTER_NAMES_JSON with jsonencode() exactly once.
$ComputerNamesJson = '${COMPUTER_NAMES_JSON}'
$ComputerOU        = ${COMPUTER_OU}
$VaultName         = ${KEY_VAULT_NAME}
$SubscriptionId    = ${SUBSCRIPTION_ID}
$LogFile           = ${LOG_FILE}

$PasswordLength = 64
$AzureConnected = $false

function Write-Log {
    [CmdletBinding()]
    param (
        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]$Message,

        [Parameter(Mandatory = $false)]
        [ValidateSet("INFO", "WARNING", "ERROR")]
        [string]$Level = "INFO"
    )

    $Entry = "{0} [{1}] {2}" -f (Get-Date -Format "yyyy-MM-dd HH:mm:ss"), $Level, $Message

    try {
        Add-Content -LiteralPath $script:LogFile -Value $Entry -Encoding UTF8 -ErrorAction Stop
    }
    catch {
        Write-Warning ("Unable to write to log file '{0}': {1}" -f $script:LogFile, $_.Exception.Message)
    }

    switch ($Level) {
        "WARNING" { Write-Host $Entry -ForegroundColor Yellow }
        "ERROR"   { Write-Host $Entry -ForegroundColor Red }
        default   { Write-Host $Entry }
    }
}

function Connect-AzureManagedIdentityWithRetry {
    [CmdletBinding()]
    param (
        [Parameter(Mandatory = $false)]
        [ValidateRange(1, 20)]
        [int]$MaximumAttempts = 10,

        [Parameter(Mandatory = $false)]
        [ValidateRange(1, 300)]
        [int]$DelaySeconds = 15
    )

    for ($Attempt = 1; $Attempt -le $MaximumAttempts; $Attempt++) {
        try {
            Write-Log ("Managed-identity authentication attempt {0} of {1}." -f $Attempt, $MaximumAttempts)
            Connect-AzAccount -Identity -ErrorAction Stop | Out-Null
            $script:AzureConnected = $true
            return
        }
        catch {
            if ($Attempt -eq $MaximumAttempts) {
                throw
            }

            Write-Log ("Managed-identity authentication failed: {0}" -f $_.Exception.Message) -Level "WARNING"
            Start-Sleep -Seconds $DelaySeconds
        }
    }
}

function Get-SecureRandomIndex {
    [CmdletBinding()]
    param (
        [Parameter(Mandatory = $true)]
        [ValidateRange(1, 255)]
        [int]$MaximumExclusive,

        [Parameter(Mandatory = $true)]
        [System.Security.Cryptography.RandomNumberGenerator]$RandomNumberGenerator
    )

    $RandomByte = New-Object -TypeName byte[] -ArgumentList 1
    $UpperBound = 256 - (256 % $MaximumExclusive)

    do {
        $RandomNumberGenerator.GetBytes($RandomByte)
        $Value = [int]$RandomByte[0]
    }
    while ($Value -ge $UpperBound)

    return $Value % $MaximumExclusive
}

function New-EnrollmentPassword {
    [CmdletBinding()]
    param (
        [Parameter(Mandatory = $false)]
        [ValidateRange(32, 128)]
        [int]$Length = 64
    )

    $UppercaseCharacters = "ABCDEFGHJKLMNPQRSTUVWXYZ"
    $LowercaseCharacters = "abcdefghijkmnopqrstuvwxyz"
    $NumberCharacters    = "23456789"
    $SpecialCharacters   = "!#%+,-.:=@_"
    $AllCharacters = $UppercaseCharacters + $LowercaseCharacters + $NumberCharacters + $SpecialCharacters

    $Characters = New-Object -TypeName "System.Collections.Generic.List[char]"
    $RandomNumberGenerator = [System.Security.Cryptography.RandomNumberGenerator]::Create()

    try {
        foreach ($CharacterSet in @(
            $UppercaseCharacters,
            $LowercaseCharacters,
            $NumberCharacters,
            $SpecialCharacters
        )) {
            $Index = Get-SecureRandomIndex -MaximumExclusive $CharacterSet.Length -RandomNumberGenerator $RandomNumberGenerator
            $Characters.Add($CharacterSet[$Index])
        }

        while ($Characters.Count -lt $Length) {
            $Index = Get-SecureRandomIndex -MaximumExclusive $AllCharacters.Length -RandomNumberGenerator $RandomNumberGenerator
            $Characters.Add($AllCharacters[$Index])
        }

        for ($CurrentIndex = $Characters.Count - 1; $CurrentIndex -gt 0; $CurrentIndex--) {
            $SwapIndex = Get-SecureRandomIndex -MaximumExclusive ($CurrentIndex + 1) -RandomNumberGenerator $RandomNumberGenerator
            $TemporaryCharacter = $Characters[$CurrentIndex]
            $Characters[$CurrentIndex] = $Characters[$SwapIndex]
            $Characters[$SwapIndex] = $TemporaryCharacter
        }

        return -join $Characters
    }
    finally {
        if ($null -ne $RandomNumberGenerator) {
            $RandomNumberGenerator.Dispose()
        }
    }
}

function Get-OrCreateComputerOU {
    [CmdletBinding()]
    param (
        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [string]$DistinguishedName
    )

    Write-Log "Checking target OU '$DistinguishedName'."

    $EscapedDistinguishedName = $DistinguishedName.Replace("'", "''")
    $ExistingOUs = @(
        Get-ADOrganizationalUnit `
            -Filter "DistinguishedName -eq '$EscapedDistinguishedName'" `
            -Properties ProtectedFromAccidentalDeletion `
            -ErrorAction Stop
    )

    if ($ExistingOUs.Count -gt 1) {
        throw "Multiple organizational units were returned for '$DistinguishedName'."
    }

    if ($ExistingOUs.Count -eq 1) {
        Write-Log ("Target OU already exists: {0}" -f $ExistingOUs[0].DistinguishedName)
        return $ExistingOUs[0]
    }

    if ($DistinguishedName -notmatch '^OU=([^,]+),(.+)$') {
        throw "Unsupported OU distinguished name '$DistinguishedName'."
    }

    $OUName = $Matches[1]
    $ParentDN = $Matches[2]

    if ([string]::IsNullOrWhiteSpace($OUName)) {
        throw "The OU name parsed from '$DistinguishedName' is empty."
    }

    if ([string]::IsNullOrWhiteSpace($ParentDN)) {
        throw "The parent DN parsed from '$DistinguishedName' is empty."
    }

    try {
        Get-ADObject -Identity $ParentDN -ErrorAction Stop | Out-Null
    }
    catch {
        throw ("The OU parent '{0}' does not exist or cannot be accessed: {1}" -f $ParentDN, $_.Exception.Message)
    }

    Write-Log ("Creating OU '{0}' under '{1}'." -f $OUName, $ParentDN)

    $NewOUParameters = @{
        Name                            = $OUName
        Path                            = $ParentDN
        Description                     = "Organizational unit for Linux computer accounts"
        ProtectedFromAccidentalDeletion = $true
        PassThru                        = $true
        ErrorAction                     = "Stop"
    }

    $CreatedOU = New-ADOrganizationalUnit @NewOUParameters

    if ($null -eq $CreatedOU) {
        throw "New-ADOrganizationalUnit returned no object for '$DistinguishedName'."
    }

    Write-Log ("Created target OU: {0}" -f $CreatedOU.DistinguishedName)
    return $CreatedOU
}

function New-ComputerEnrollmentPair {
    [CmdletBinding()]
    param (
        [Parameter(Mandatory = $true)]
        [ValidateNotNullOrEmpty()]
        [ValidatePattern('^[A-Za-z0-9-]{1,15}$')]
        [string]$ComputerName
    )

    $NormalizedComputerName = $ComputerName.Trim().ToUpperInvariant()
    $ComputerSamAccountName = "{0}$" -f $NormalizedComputerName
    $SecretName = $NormalizedComputerName

    $ComputerCreatedByThisOperation = $false
    $CreatedComputer = $null
    $VerifiedComputer = $null
    $EnrollmentPasswordPlainText = $null
    $EnrollmentPassword = $null

    try {
        Write-Log ("Checking Active Directory for computer '{0}'." -f $ComputerSamAccountName)

        $EscapedSamAccountName = $ComputerSamAccountName.Replace("'", "''")
        $MatchingComputers = @(
            Get-ADComputer `
                -Filter "SamAccountName -eq '$EscapedSamAccountName'" `
                -Properties DistinguishedName, Enabled, SamAccountName `
                -ErrorAction Stop
        )

        if ($MatchingComputers.Count -gt 1) {
            throw "Multiple AD computers were returned for sAMAccountName '$ComputerSamAccountName'."
        }

        if ($MatchingComputers.Count -eq 1) {
            Write-Log ("Computer '{0}' already exists as '{1}'. Skipping it." -f $ComputerSamAccountName, $MatchingComputers[0].DistinguishedName) -Level "WARNING"

            return [pscustomobject]@{
                ComputerName = $NormalizedComputerName
                State        = "SkippedExisting"
                ADObject     = $MatchingComputers[0].DistinguishedName
                SecretName   = $null
                Error        = $null
            }
        }

        Write-Log ("Computer '{0}' does not exist. Generating its enrollment password." -f $ComputerSamAccountName)

        $EnrollmentPasswordPlainText = New-EnrollmentPassword -Length $script:PasswordLength
        $EnrollmentPassword = ConvertTo-SecureString -String $EnrollmentPasswordPlainText -AsPlainText -Force

        $ConcurrentMatches = @(
            Get-ADComputer `
                -Filter "SamAccountName -eq '$EscapedSamAccountName'" `
                -Properties DistinguishedName `
                -ErrorAction Stop
        )

        if ($ConcurrentMatches.Count -gt 0) {
            Write-Log ("Computer '{0}' appeared during provisioning. Skipping it." -f $ComputerSamAccountName) -Level "WARNING"

            return [pscustomobject]@{
                ComputerName = $NormalizedComputerName
                State        = "SkippedConcurrent"
                ADObject     = $ConcurrentMatches[0].DistinguishedName
                SecretName   = $null
                Error        = $null
            }
        }

        $NewComputerParameters = @{
            Name            = $NormalizedComputerName
            SamAccountName  = $ComputerSamAccountName
            AccountPassword = $EnrollmentPassword
            Path            = $script:ComputerOU
            Enabled         = $true
            Description     = "Prestaged Linux computer enrollment account"
            PassThru        = $true
            ErrorAction     = "Stop"
        }

        Write-Log ("Creating AD computer '{0}' in '{1}'." -f $ComputerSamAccountName, $script:ComputerOU)
        $CreatedComputer = New-ADComputer @NewComputerParameters
        $ComputerCreatedByThisOperation = $true

        if ($null -eq $CreatedComputer) {
            throw "New-ADComputer returned no object for '$NormalizedComputerName'."
        }

        $VerifiedComputer = Get-ADComputer `
            -Identity $CreatedComputer.DistinguishedName `
            -Properties DistinguishedName, Enabled, SamAccountName `
            -ErrorAction Stop

        if ($VerifiedComputer.SamAccountName -ne $ComputerSamAccountName) {
            throw ("AD verification failed for '{0}': expected sAMAccountName '{1}', received '{2}'." -f $NormalizedComputerName, $ComputerSamAccountName, $VerifiedComputer.SamAccountName)
        }

        if (-not $VerifiedComputer.Enabled) {
            throw "AD verification failed for '$NormalizedComputerName': the computer account is disabled."
        }

        $SecretTags = @{
            ComputerName      = $NormalizedComputerName
            SamAccountName    = $ComputerSamAccountName
            ComputerObjectDN  = $VerifiedComputer.DistinguishedName
            Purpose           = "Linux-AD-Enrollment"
            ProvisioningState = "Pending-Consumption"
        }

        $SecretParameters = @{
            VaultName   = $script:VaultName
            Name        = $SecretName
            SecretValue = $EnrollmentPassword
            ContentType = "Linux Active Directory enrollment password"
            Tag         = $SecretTags
            ErrorAction = "Stop"
        }

        Write-Log ("Storing enrollment password as Key Vault secret '{0}'." -f $SecretName)
        $CreatedSecret = Set-AzKeyVaultSecret @SecretParameters

        if ($null -eq $CreatedSecret -or [string]::IsNullOrWhiteSpace($CreatedSecret.Id)) {
            throw "Key Vault did not return a valid secret ID for '$SecretName'."
        }

        $ComputerCreatedByThisOperation = $false

        Write-Log ("Computer '{0}' and Key Vault secret '{1}' were created successfully." -f $ComputerSamAccountName, $CreatedSecret.Name)

        return [pscustomobject]@{
            ComputerName = $NormalizedComputerName
            State        = "Provisioned"
            ADObject     = $VerifiedComputer.DistinguishedName
            SecretName   = $CreatedSecret.Name
            Error        = $null
        }
    }
    catch {
        $OriginalError = $_.Exception

        Write-Log ("Provisioning failed for '{0}': {1}" -f $NormalizedComputerName, $OriginalError.Message) -Level "ERROR"

        if ($ComputerCreatedByThisOperation -and $null -ne $CreatedComputer) {
            Write-Log ("Removing newly created AD computer '{0}' because provisioning did not complete." -f $ComputerSamAccountName) -Level "WARNING"

            try {
                Remove-ADComputer `
                    -Identity $CreatedComputer.DistinguishedName `
                    -Confirm:$false `
                    -ErrorAction Stop

                Write-Log ("Rollback succeeded for '{0}'." -f $ComputerSamAccountName) -Level "WARNING"
            }
            catch {
                $RollbackError = $_.Exception.Message

                Write-Log ("Rollback failed for '{0}': {1}" -f $ComputerSamAccountName, $RollbackError) -Level "ERROR"

                return [pscustomobject]@{
                    ComputerName = $NormalizedComputerName
                    State        = "RollbackFailed"
                    ADObject     = $CreatedComputer.DistinguishedName
                    SecretName   = $SecretName
                    Error        = "Provisioning error: {0}; rollback error: {1}" -f $OriginalError.Message, $RollbackError
                }
            }
        }

        return [pscustomobject]@{
            ComputerName = $NormalizedComputerName
            State        = "Failed"
            ADObject     = $null
            SecretName   = $SecretName
            Error        = $OriginalError.Message
        }
    }
    finally {
        $EnrollmentPasswordPlainText = $null
        $EnrollmentPassword = $null
    }
}

$LogDirectory = Split-Path -Path $LogFile -Parent

if (-not [string]::IsNullOrWhiteSpace($LogDirectory) -and -not (Test-Path -LiteralPath $LogDirectory)) {
    New-Item -ItemType Directory -Path $LogDirectory -Force -ErrorAction Stop | Out-Null
}

Write-Log "Starting Linux computer enrollment provisioning."

try {
    $ParsedComputerNames = ConvertFrom-Json -InputObject $ComputerNamesJson -ErrorAction Stop

    $ComputerNames = @(
        foreach ($ComputerName in $ParsedComputerNames) {
            $ComputerName
        }
    )

    if ($ComputerNames.Count -eq 0) {
        Write-Log "No computer names were supplied. No changes are required." -Level "WARNING"
        return
    }

    $NormalizedComputerNames = @(
        foreach ($ComputerName in $ComputerNames) {
            if ($null -eq $ComputerName) {
                throw "The computer-name array contains a null value."
            }

            $NormalizedName = ([string]$ComputerName).Trim().ToUpperInvariant()

            if ($NormalizedName -notmatch '^[A-Z0-9-]{1,15}$') {
                throw "Invalid computer name '$ComputerName'. Names must contain 1 through 15 letters, numbers, or hyphens."
            }

            $NormalizedName
        }
    )

    $DuplicateComputerNames = @(
        $NormalizedComputerNames |
            Group-Object |
            Where-Object { $_.Count -gt 1 } |
            Select-Object -ExpandProperty Name
    )

    if ($DuplicateComputerNames.Count -gt 0) {
        throw ("Duplicate computer names were supplied: {0}" -f ($DuplicateComputerNames -join ", "))
    }

    Import-Module ActiveDirectory -ErrorAction Stop
    Import-Module Az.Accounts -ErrorAction Stop
    Import-Module Az.KeyVault -ErrorAction Stop

    $TargetOU = Get-OrCreateComputerOU -DistinguishedName $ComputerOU

    if ($null -eq $TargetOU) {
        throw "The target OU could not be found or created: $ComputerOU"
    }

    $ComputerOU = $TargetOU.DistinguishedName

    Disable-AzContextAutosave -Scope Process -ErrorAction Stop | Out-Null
    Clear-AzContext -Scope Process -Force -ErrorAction SilentlyContinue

    Connect-AzureManagedIdentityWithRetry

    if (-not [string]::IsNullOrWhiteSpace($SubscriptionId)) {
        Set-AzContext -SubscriptionId $SubscriptionId -ErrorAction Stop | Out-Null
    }

    $Results = @(
        foreach ($ComputerName in $NormalizedComputerNames) {
            Write-Log "Processing computer '$ComputerName'."
            New-ComputerEnrollmentPair -ComputerName $ComputerName
        }
    )

    $FailedResults = @(
        $Results |
            Where-Object { $_.State -in @("Failed", "RollbackFailed") }
    )

    Write-Host ""
    Write-Host "Linux computer enrollment results"
    Write-Host "================================="
    Write-Host ""

    foreach ($Result in $Results) {
        Write-Host ("{0}: {1}" -f $Result.ComputerName, $Result.State)

        if (-not [string]::IsNullOrWhiteSpace([string]$Result.ADObject)) {
            Write-Host "  AD object: $($Result.ADObject)"
        }

        if (-not [string]::IsNullOrWhiteSpace([string]$Result.SecretName)) {
            Write-Host "  Secret:    $($Result.SecretName)"
        }

        if (-not [string]::IsNullOrWhiteSpace([string]$Result.Error)) {
            Write-Host "  Error:     $($Result.Error)" -ForegroundColor Red
        }
    }

    if ($FailedResults.Count -gt 0) {
        throw ("{0} computer enrollment operation(s) failed. Review '{1}'." -f $FailedResults.Count, $LogFile)
    }

    Write-Log "Linux computer enrollment completed successfully."
}
catch {
    Write-Log ("Batch provisioning failed: {0}" -f $_.Exception.Message) -Level "ERROR"
    throw
}
finally {
    if ($AzureConnected) {
        Disconnect-AzAccount -Scope Process -ErrorAction SilentlyContinue | Out-Null
        Clear-AzContext -Scope Process -Force -ErrorAction SilentlyContinue
    }

    Write-Log "Script execution ended."
}
