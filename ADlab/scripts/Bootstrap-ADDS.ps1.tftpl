#Requires -Version 5.1
#Requires -RunAsAdministrator

<#
.SYNOPSIS
    Promotes a Windows Server to the first domain controller and configures
    post-reboot Linux computer-account enrollment.

.DESCRIPTION
    The Azure Windows Custom Script Extension downloads these files into the
    same temporary extension directory:

      Bootstrap-ADDS.ps1
      Complete-LinuxEnrollment.ps1
      LinuxComputerEnrollment.ps1

    This script:

      1. Copies the continuation scripts into a persistent directory.
      2. Installs the required Azure PowerShell modules.
      3. Authenticates with the VM's system-assigned managed identity.
      4. Retrieves the DSRM password from Azure Key Vault.
      5. Installs AD Domain Services.
      6. Registers a SYSTEM startup task.
      7. Creates the new Active Directory forest.
      8. Schedules a reboot after returning control to the extension.

    No password is passed through Terraform, Blob Storage, the extension
    command line, or the script files.
#>

[CmdletBinding()]
param ()

Set-StrictMode -Version 2.0
$ErrorActionPreference = "Stop"

#
# Values rendered by Terraform.
#
$DomainName        = ${DOMAIN_NAME}
$DomainNetbiosName = ${DOMAIN_NETBIOS_NAME}
$SubscriptionId    = ${SUBSCRIPTION_ID}
$DsrmVaultName     = ${DSRM_VAULT_NAME}
$DsrmSecretName    = ${DSRM_SECRET_NAME}

#
# Files downloaded by Custom Script Extension.
#
$DownloadedPostRebootScript = Join-Path `
    -Path $PSScriptRoot `
    -ChildPath "Complete-LinuxEnrollment.ps1"

$DownloadedEnrollmentScript = Join-Path `
    -Path $PSScriptRoot `
    -ChildPath "LinuxComputerEnrollment.ps1"

#
# Persistent locations used after the extension directory is no longer needed.
#
$ProvisioningRoot = "C:\ProgramData\LinuxADProvisioning"

$PostRebootScript = Join-Path `
    -Path $ProvisioningRoot `
    -ChildPath "Complete-LinuxEnrollment.ps1"

$EnrollmentScript = Join-Path `
    -Path $ProvisioningRoot `
    -ChildPath "LinuxComputerEnrollment.ps1"

$BootstrapLog = Join-Path `
    -Path $ProvisioningRoot `
    -ChildPath "Bootstrap.log"

$TaskName = "Complete-Linux-AD-Provisioning"

$AzureConnected = $false
$DsrmPassword = $null
$ForestPromotionStarted = $false

function Write-BootstrapLog {
    [CmdletBinding()]
    param (
        [Parameter(Mandatory)]
        [ValidateNotNullOrEmpty()]
        [string]$Message,

        [Parameter()]
        [ValidateSet("INFO", "WARNING", "ERROR")]
        [string]$Level = "INFO"
    )

    $Entry = "{0} [{1}] {2}" -f (
        Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    ), $Level, $Message

    try {
        Add-Content `
            -LiteralPath $script:BootstrapLog `
            -Value $Entry `
            -Encoding UTF8 `
            -ErrorAction Stop
    }
    catch {
        Write-Warning (
            "Unable to write to bootstrap log '{0}': {1}" -f
            $script:BootstrapLog,
            $_.Exception.Message
        )
    }

    switch ($Level) {
        "WARNING" {
            Write-Host $Entry -ForegroundColor Yellow
        }

        "ERROR" {
            Write-Host $Entry -ForegroundColor Red
        }

        default {
            Write-Host $Entry
        }
    }
}

function Copy-ProvisioningScript {
    [CmdletBinding()]
    param (
        [Parameter(Mandatory)]
        [ValidateNotNullOrEmpty()]
        [string]$Source,

        [Parameter(Mandatory)]
        [ValidateNotNullOrEmpty()]
        [string]$Destination
    )

    if (-not (Test-Path -LiteralPath $Source -PathType Leaf)) {
        throw "Downloaded provisioning script was not found: $Source"
    }

    Copy-Item `
        -LiteralPath $Source `
        -Destination $Destination `
        -Force `
        -ErrorAction Stop

    if (-not (Test-Path -LiteralPath $Destination -PathType Leaf)) {
        throw "Provisioning script copy could not be verified: $Destination"
    }

    $SourceHash = Get-FileHash `
        -LiteralPath $Source `
        -Algorithm SHA256 `
        -ErrorAction Stop

    $DestinationHash = Get-FileHash `
        -LiteralPath $Destination `
        -Algorithm SHA256 `
        -ErrorAction Stop

    if ($SourceHash.Hash -ne $DestinationHash.Hash) {
        throw (
            "Provisioning script hash verification failed for '{0}'." -f
            $Destination
        )
    }

    Write-BootstrapLog (
        "Provisioning script staged successfully: {0}" -f
        $Destination
    )
}

function Install-RequiredPowerShellModule {
    [CmdletBinding()]
    param (
        [Parameter(Mandatory)]
        [ValidateNotNullOrEmpty()]
        [string]$Name
    )

    if (Get-Module -ListAvailable -Name $Name) {
        Write-BootstrapLog "PowerShell module '$Name' is already installed."
        return
    }

    Write-BootstrapLog "Installing PowerShell module '$Name'."

    Install-Module `
        -Name $Name `
        -Repository "PSGallery" `
        -Scope AllUsers `
        -Force `
        -AllowClobber `
        -ErrorAction Stop
}

function Connect-AzureManagedIdentityWithRetry {
    [CmdletBinding()]
    param (
        [Parameter()]
        [ValidateRange(1, 20)]
        [int]$MaximumAttempts = 10,

        [Parameter()]
        [ValidateRange(1, 300)]
        [int]$DelaySeconds = 15
    )

    for ($Attempt = 1; $Attempt -le $MaximumAttempts; $Attempt++) {
        try {
            Write-BootstrapLog (
                "Managed-identity authentication attempt {0} of {1}." -f
                $Attempt,
                $MaximumAttempts
            )

            Connect-AzAccount `
                -Identity `
                -ErrorAction Stop | Out-Null

            $script:AzureConnected = $true

            return
        }
        catch {
            if ($Attempt -eq $MaximumAttempts) {
                throw
            }

            Write-BootstrapLog (
                "Managed-identity authentication failed: {0}" -f
                $_.Exception.Message
            ) -Level "WARNING"

            Start-Sleep -Seconds $DelaySeconds
        }
    }
}

function Get-DsrmPasswordWithRetry {
    [CmdletBinding()]
    param (
        [Parameter()]
        [ValidateRange(1, 20)]
        [int]$MaximumAttempts = 10,

        [Parameter()]
        [ValidateRange(1, 300)]
        [int]$DelaySeconds = 15
    )

    for ($Attempt = 1; $Attempt -le $MaximumAttempts; $Attempt++) {
        try {
            Write-BootstrapLog (
                "DSRM secret retrieval attempt {0} of {1}." -f
                $Attempt,
                $MaximumAttempts
            )

            $Secret = Get-AzKeyVaultSecret `
                -VaultName $script:DsrmVaultName `
                -Name $script:DsrmSecretName `
                -ErrorAction Stop

            if ($null -eq $Secret -or $null -eq $Secret.SecretValue) {
                throw "Key Vault returned no DSRM secret value."
            }

            return $Secret.SecretValue
        }
        catch {
            if ($Attempt -eq $MaximumAttempts) {
                throw
            }

            Write-BootstrapLog (
                "DSRM secret retrieval failed: {0}" -f
                $_.Exception.Message
            ) -Level "WARNING"

            Start-Sleep -Seconds $DelaySeconds
        }
    }

    throw "The DSRM password could not be retrieved."
}

function Register-PostRebootTask {
    [CmdletBinding()]
    param ()

    Write-BootstrapLog "Registering the post-reboot provisioning task."

    $TaskArguments = (
        '-NoLogo -NoProfile -NonInteractive ' +
        '-ExecutionPolicy Bypass ' +
        '-File "{0}"' -f $script:PostRebootScript
    )

    $TaskAction = New-ScheduledTaskAction `
        -Execute "powershell.exe" `
        -Argument $TaskArguments

    $TaskTrigger = New-ScheduledTaskTrigger -AtStartup

    $TaskPrincipal = New-ScheduledTaskPrincipal `
        -UserId "SYSTEM" `
        -LogonType ServiceAccount `
        -RunLevel Highest

    $TaskSettings = New-ScheduledTaskSettingsSet `
        -StartWhenAvailable `
        -ExecutionTimeLimit (New-TimeSpan -Hours 2) `
        -RestartCount 5 `
        -RestartInterval (New-TimeSpan -Minutes 2)

    Register-ScheduledTask `
        -TaskName $script:TaskName `
        -Action $TaskAction `
        -Trigger $TaskTrigger `
        -Principal $TaskPrincipal `
        -Settings $TaskSettings `
        -Force `
        -ErrorAction Stop | Out-Null

    Write-BootstrapLog "Post-reboot provisioning task registered."
}

function Remove-PostRebootTask {
    [CmdletBinding()]
    param ()

    $ExistingTask = Get-ScheduledTask `
        -TaskName $script:TaskName `
        -ErrorAction SilentlyContinue

    if ($null -ne $ExistingTask) {
        Unregister-ScheduledTask `
            -TaskName $script:TaskName `
            -Confirm:$false `
            -ErrorAction SilentlyContinue
    }
}

try {
    if (-not (Test-Path -LiteralPath $ProvisioningRoot)) {
        New-Item `
            -ItemType Directory `
            -Path $ProvisioningRoot `
            -Force `
            -ErrorAction Stop | Out-Null
    }

    Write-BootstrapLog "Starting Active Directory bootstrap."
    Write-BootstrapLog "Extension working directory: $PSScriptRoot"

    if (:IsNullOrWhiteSpace($DomainName)) {
        throw "DomainName is empty."
    }

    if (:IsNullOrWhiteSpace($DomainNetbiosName)) {
        throw "DomainNetbiosName is empty."
    }

    if ($DomainNetbiosName.Length -gt 15) {
        throw "DomainNetbiosName cannot exceed 15 characters."
    }

    if ($DomainNetbiosName -notmatch "^[A-Za-z0-9-]+$") {
        throw (
            "DomainNetbiosName may contain only letters, numbers, " +
            "and hyphens."
        )
    }

    #
    # Stage the scripts downloaded by Custom Script Extension.
    #
    Copy-ProvisioningScript `
        -Source $DownloadedPostRebootScript `
        -Destination $PostRebootScript

    Copy-ProvisioningScript `
        -Source $DownloadedEnrollmentScript `
        -Destination $EnrollmentScript

    #
    # Use TLS 1.2 for PowerShell Gallery access.
    #
    [Net.ServicePointManager]::SecurityProtocol = `
        [Net.SecurityProtocolType]::Tls12

    if (-not (Get-PackageProvider -Name NuGet -ErrorAction SilentlyContinue)) {
        Write-BootstrapLog "Installing the NuGet package provider."

        Install-PackageProvider `
            -Name NuGet `
            -MinimumVersion "2.8.5.201" `
            -Force `
            -ErrorAction Stop | Out-Null
    }

    $Gallery = Get-PSRepository `
        -Name "PSGallery" `
        -ErrorAction SilentlyContinue

    if ($null -eq $Gallery) {
        throw "PSGallery is not registered on this server."
    }

    if ($Gallery.InstallationPolicy -ne "Trusted") {
        Write-BootstrapLog "Setting PSGallery as trusted."

        Set-PSRepository `
            -Name "PSGallery" `
            -InstallationPolicy Trusted `
            -ErrorAction Stop
    }

    Install-RequiredPowerShellModule -Name "Az.Accounts"
    Install-RequiredPowerShellModule -Name "Az.KeyVault"

    Import-Module Az.Accounts -ErrorAction Stop
    Import-Module Az.KeyVault -ErrorAction Stop

    Disable-AzContextAutosave `
        -Scope Process `
        -ErrorAction Stop | Out-Null

    Clear-AzContext `
        -Scope Process `
        -Force `
        -ErrorAction SilentlyContinue

    Connect-AzureManagedIdentityWithRetry

    if (-not :IsNullOrWhiteSpace($SubscriptionId)) {
        Set-AzContext `
            -SubscriptionId $SubscriptionId `
            -ErrorAction Stop | Out-Null
    }

    $DsrmPassword = Get-DsrmPasswordWithRetry

    Write-BootstrapLog "Installing AD Domain Services."

    $FeatureResult = Install-WindowsFeature `
        -Name "AD-Domain-Services" `
        -IncludeManagementTools `
        -ErrorAction Stop

    if (-not $FeatureResult.Success) {
        throw "AD Domain Services installation did not report success."
    }

    #
    # Register before promotion so the task exists after the reboot.
    #
    Register-PostRebootTask

    #
    # Idempotent rerun handling.
    #
    $NtdsService = Get-Service `
        -Name "NTDS" `
        -ErrorAction SilentlyContinue

    if ($null -ne $NtdsService) {
        Write-BootstrapLog (
            "NTDS already exists. Forest promotion will not be repeated."
        ) -Level "WARNING"

        Start-ScheduledTask `
            -TaskName $TaskName `
            -ErrorAction Stop

        return
    }

    Write-BootstrapLog (
        "Creating Active Directory forest '{0}'." -f
        $DomainName
    )

    Import-Module ADDSDeployment -ErrorAction Stop

    $ForestPromotionStarted = $true

    Install-ADDSForest `
        -DomainName $DomainName `
        -DomainNetbiosName $DomainNetbiosName `
        -SafeModeAdministratorPassword $DsrmPassword `
        -InstallDns:$true `
        -CreateDnsDelegation:$false `
        -DatabasePath "C:\Windows\NTDS" `
        -LogPath "C:\Windows\NTDS" `
        -SysvolPath "C:\Windows\SYSVOL" `
        -DomainMode "WinThreshold" `
        -ForestMode "WinThreshold" `
        -NoRebootOnCompletion:$true `
        -Force:$true `
        -ErrorAction Stop

    $DsrmPassword = $null

    Write-BootstrapLog (
        "Forest promotion completed. A restart is scheduled in 60 seconds."
    )

    #
    # Do not restart synchronously inside the extension process.
    #
    Start-Process `
        -FilePath "$env:SystemRoot\System32\shutdown.exe" `
        -ArgumentList (
            '/r /t 60 /f /c ' +
            '"Completing Active Directory provisioning"'
        ) `
        -WindowStyle Hidden

    Write-BootstrapLog "Bootstrap completed successfully."
}
catch {
    Write-BootstrapLog `
        -Message "Bootstrap failed: $($_.Exception.Message)" `
        -Level "ERROR"

    #
    # If promotion did not begin, the startup task has no valid post-promotion
    # work to perform. Remove it to prevent repeated startup failures.
    #
    if (-not $ForestPromotionStarted) {
        Remove-PostRebootTask
    }

    throw
}
finally {
    $DsrmPassword = $null

    if ($AzureConnected) {
        Disconnect-AzAccount `
            -Scope Process `
            -ErrorAction SilentlyContinue | Out-Null

        Clear-AzContext `
            -Scope Process `
            -Force `
            -ErrorAction SilentlyContinue
    }
}
