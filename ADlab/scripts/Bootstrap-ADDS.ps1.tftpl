#Requires -Version 5.1
#Requires -RunAsAdministrator

<#
.SYNOPSIS
    Autonomous AD DS bootstrap for controller22.

.DESCRIPTION
    Runs under the Azure Windows Custom Script Extension. It stages the
    post-reboot scripts, retrieves the DSRM password from Azure Key Vault by
    using the VM system-assigned managed identity, installs AD DS, validates
    the new forest configuration, promotes the server to the first writable
    domain controller with DNS, registers the post-reboot continuation task,
    and schedules a controlled reboot after the extension can return success.
#>

[CmdletBinding()]
param ()

Set-StrictMode -Version 2.0
$ErrorActionPreference = "Stop"
$ProgressPreference = "SilentlyContinue"

# Values rendered by Terraform. jsonencode() makes each value a valid
# PowerShell string literal in the rendered script.
$DomainName       = ${DOMAIN_NAME}
$DomainNetbiosName = ${DOMAIN_NETBIOS_NAME}
$SubscriptionId   = ${SUBSCRIPTION_ID}
$DsrmVaultName    = ${DSRM_VAULT_NAME}
$DsrmSecretName   = ${DSRM_SECRET_NAME}

$ProvisioningRoot = "C:\ProgramData\LinuxADProvisioning"
$BootstrapLog     = Join-Path -Path $ProvisioningRoot -ChildPath "Bootstrap.log"
$Phase1Marker     = Join-Path -Path $ProvisioningRoot -ChildPath "ADDS-Phase1-Complete.txt"
$FailureMarker    = Join-Path -Path $ProvisioningRoot -ChildPath "ADDS-Phase1-Failed.txt"

$DownloadedPostRebootScript = Join-Path -Path $PSScriptRoot -ChildPath "Complete-LinuxEnrollment.ps1"
$DownloadedEnrollmentScript = Join-Path -Path $PSScriptRoot -ChildPath "LinuxComputerEnrollment.ps1"
$PostRebootScript = Join-Path -Path $ProvisioningRoot -ChildPath "Complete-LinuxEnrollment.ps1"
$EnrollmentScript = Join-Path -Path $ProvisioningRoot -ChildPath "LinuxComputerEnrollment.ps1"

$PostRebootTaskName = "Complete-Linux-AD-Provisioning"
$RebootTaskName     = "ADDS-Promotion-Reboot"

function Write-BootstrapLog {
    [CmdletBinding()]
    param (
        [Parameter(Mandatory)]
        [ValidateNotNullOrEmpty()]
        [string]$Message,

        [Parameter()]
        [ValidateSet("INFO", "WARNING", "ERROR", "SUCCESS")]
        [string]$Level = "INFO"
    )

    $entry = "{0} [{1}] {2}" -f (Get-Date -Format "yyyy-MM-dd HH:mm:ss"), $Level, $Message
    Write-Host $entry

    try {
        Add-Content -LiteralPath $script:BootstrapLog -Value $entry -Encoding UTF8 -ErrorAction Stop
    }
    catch {
        Write-Warning "Unable to write bootstrap log: $($_.Exception.Message)"
    }
}

function Get-ManagedIdentityToken {
    [CmdletBinding()]
    param (
        [Parameter(Mandatory)]
        [ValidateNotNullOrEmpty()]
        [string]$Resource,

        [ValidateRange(1, 20)]
        [int]$MaximumAttempts = 10,

        [ValidateRange(1, 120)]
        [int]$DelaySeconds = 15
    )

    $encodedResource = [Uri]::EscapeDataString($Resource)
    $uri = "http://169.254.169.254/metadata/identity/oauth2/token?api-version=2018-02-01&resource=$encodedResource"
    $headers = @{ Metadata = "true" }

    for ($attempt = 1; $attempt -le $MaximumAttempts; $attempt++) {
        try {
            Write-BootstrapLog -Message "Managed identity token attempt $attempt of $MaximumAttempts."
            $response = Invoke-RestMethod -Method GET -Uri $uri -Headers $headers -TimeoutSec 30 -ErrorAction Stop

            if ([string]$response.access_token -eq "") {
                throw "Managed identity endpoint returned an empty access token."
            }

            return [string]$response.access_token
        }
        catch {
            if ($attempt -eq $MaximumAttempts) {
                throw
            }

            Write-BootstrapLog -Message "Managed identity token request failed: $($_.Exception.Message)" -Level "WARNING"
            Start-Sleep -Seconds $DelaySeconds
        }
    }
}

function Get-DsrmPasswordWithRetry {
    [CmdletBinding()]
    param (
        [ValidateRange(1, 20)]
        [int]$MaximumAttempts = 10,

        [ValidateRange(1, 120)]
        [int]$DelaySeconds = 15
    )

    $secretName = [Uri]::EscapeDataString($script:DsrmSecretName)
    $secretUri = "https://$($script:DsrmVaultName).vault.azure.net/secrets/$($secretName)?api-version=7.4"

    for ($attempt = 1; $attempt -le $MaximumAttempts; $attempt++) {
        try {
            Write-BootstrapLog -Message "Key Vault DSRM retrieval attempt $attempt of $MaximumAttempts."
            $token = Get-ManagedIdentityToken -Resource "https://vault.azure.net"
            $headers = @{ Authorization = "Bearer $token" }
            $secret = Invoke-RestMethod -Method GET -Uri $secretUri -Headers $headers -TimeoutSec 30 -ErrorAction Stop

            if ([string]$secret.value -eq "") {
                throw "Key Vault returned an empty DSRM secret value."
            }

            return [string]$secret.value
        }
        catch {
            if ($attempt -eq $MaximumAttempts) {
                throw
            }

            Write-BootstrapLog -Message "DSRM secret retrieval failed: $($_.Exception.Message)" -Level "WARNING"
            Start-Sleep -Seconds $DelaySeconds
        }
    }
}


function Install-EnrollmentPrerequisites {
    [CmdletBinding()]
    param ()

    $requiredModules = @(
        "Az.Accounts",
        "Az.KeyVault"
    )

    $minimumPackageModules = @(
        @{
            Name           = "PackageManagement"
            MinimumVersion = [version]"1.4.8.1"
        },
        @{
            Name           = "PowerShellGet"
            MinimumVersion = [version]"2.2.5"
        }
    )

    $originalConfirmPreference = $ConfirmPreference
    $ConfirmPreference = "None"

    try {
        # PowerShell Gallery requires TLS 1.2 or later. Preserve any protocols
        # already enabled in the current Windows PowerShell process.
        if (([Net.ServicePointManager]::SecurityProtocol -band [Net.SecurityProtocolType]::Tls12) -eq 0) {
            [Net.ServicePointManager]::SecurityProtocol =
                [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12
        }

        # Windows PowerShell 5.1 commonly needs the NuGet provider bootstrapped
        # before Install-Module can resolve modules and their dependencies.
        $nuGetProvider = Get-PackageProvider `
            -Name "NuGet" `
            -ListAvailable `
            -ErrorAction SilentlyContinue |
            Sort-Object -Property Version -Descending |
            Select-Object -First 1

        if (($null -eq $nuGetProvider) -or
            ($nuGetProvider.Version -lt [version]"2.8.5.201")) {
            Write-BootstrapLog -Message "Installing or updating the NuGet package provider."

            Install-PackageProvider `
                -Name "NuGet" `
                -MinimumVersion "2.8.5.201" `
                -Scope AllUsers `
                -Force `
                -Confirm:$false `
                -ErrorAction Stop | Out-Null
        }

        Import-PackageProvider `
            -Name "NuGet" `
            -MinimumVersion "2.8.5.201" `
            -Force `
            -ErrorAction Stop | Out-Null

        $gallery = Get-PSRepository -Name "PSGallery" -ErrorAction SilentlyContinue
        if ($null -eq $gallery) {
            Write-BootstrapLog -Message "Registering the default PowerShell Gallery repository."
            Register-PSRepository -Default -ErrorAction Stop
            $gallery = Get-PSRepository -Name "PSGallery" -ErrorAction Stop
        }

        if ($gallery.InstallationPolicy -ne "Trusted") {
            Write-BootstrapLog -Message "Configuring PSGallery as a trusted repository."
            Set-PSRepository `
                -Name "PSGallery" `
                -InstallationPolicy Trusted `
                -ErrorAction Stop
        }

        # Upgrade the Windows PowerShell package-management components when the
        # inbox versions are older. The newer versions are installed side by
        # side and will be used by subsequent PowerShell processes.
        foreach ($packageModule in $minimumPackageModules) {
            $installedPackageModule = Get-Module `
                -Name $packageModule.Name `
                -ListAvailable `
                -ErrorAction SilentlyContinue |
                Sort-Object -Property Version -Descending |
                Select-Object -First 1

            if (($null -eq $installedPackageModule) -or
                ($installedPackageModule.Version -lt $packageModule.MinimumVersion)) {
                Write-BootstrapLog -Message (
                    "Installing or updating PowerShell package module '{0}' to at least version {1}." -f
                    $packageModule.Name,
                    $packageModule.MinimumVersion
                )

                Install-Module `
                    -Name $packageModule.Name `
                    -MinimumVersion ([string]$packageModule.MinimumVersion) `
                    -Repository "PSGallery" `
                    -Scope AllUsers `
                    -Force `
                    -AllowClobber `
                    -Confirm:$false `
                    -ErrorAction Stop
            }

            $installedPackageModule = Get-Module `
                -Name $packageModule.Name `
                -ListAvailable `
                -ErrorAction Stop |
                Sort-Object -Property Version -Descending |
                Select-Object -First 1

            if (($null -eq $installedPackageModule) -or
                ($installedPackageModule.Version -lt $packageModule.MinimumVersion)) {
                throw (
                    "PowerShell package module '{0}' version {1} or later is required." -f
                    $packageModule.Name,
                    $packageModule.MinimumVersion
                )
            }

            Write-BootstrapLog -Message (
                "PowerShell package module '{0}' version {1} is available." -f
                $packageModule.Name,
                $installedPackageModule.Version
            ) -Level "SUCCESS"
        }

        foreach ($moduleName in $requiredModules) {
            $installedModule = Get-Module `
                -Name $moduleName `
                -ListAvailable `
                -ErrorAction SilentlyContinue |
                Sort-Object -Property Version -Descending |
                Select-Object -First 1

            if ($null -eq $installedModule) {
                Write-BootstrapLog -Message (
                    "Installing required PowerShell module '{0}' and its declared dependencies." -f
                    $moduleName
                )

                Install-Module `
                    -Name $moduleName `
                    -Repository "PSGallery" `
                    -Scope AllUsers `
                    -Force `
                    -AllowClobber `
                    -Confirm:$false `
                    -ErrorAction Stop
            }

            $installedModule = Get-Module `
                -Name $moduleName `
                -ListAvailable `
                -ErrorAction Stop |
                Sort-Object -Property Version -Descending |
                Select-Object -First 1

            if ($null -eq $installedModule) {
                throw "PowerShell module '$moduleName' was not found after installation."
            }

            Import-Module `
                -Name $moduleName `
                -Force `
                -ErrorAction Stop

            Write-BootstrapLog -Message (
                "PowerShell module '{0}' version {1} is installed and importable." -f
                $moduleName,
                $installedModule.Version
            ) -Level "SUCCESS"
        }

        Write-BootstrapLog -Message (
            "Linux enrollment PowerShell prerequisites and dependencies are available."
        ) -Level "SUCCESS"
    }
    finally {
        $ConfirmPreference = $originalConfirmPreference
    }
}

function Register-PostRebootTask {
    [CmdletBinding()]
    param ()

    $action = New-ScheduledTaskAction `
        -Execute "PowerShell.exe" `
        -Argument "-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File `"$script:PostRebootScript`""

    $trigger = New-ScheduledTaskTrigger -AtStartup

    $principal = New-ScheduledTaskPrincipal `
        -UserId "SYSTEM" `
        -LogonType ServiceAccount `
        -RunLevel Highest

    $settings = New-ScheduledTaskSettingsSet `
        -StartWhenAvailable `
        -MultipleInstances IgnoreNew `
        -ExecutionTimeLimit (New-TimeSpan -Hours 1)

    Register-ScheduledTask `
        -TaskName $script:PostRebootTaskName `
        -Action $action `
        -Trigger $trigger `
        -Principal $principal `
        -Settings $settings `
        -Force `
        -ErrorAction Stop | Out-Null

    if ((Get-ScheduledTask -TaskName $script:PostRebootTaskName -ErrorAction Stop).TaskName -ne $script:PostRebootTaskName) {
        throw "Unable to verify scheduled task '$($script:PostRebootTaskName)'."
    }
}

function Remove-PostRebootTask {
    [CmdletBinding()]
    param ()

    Unregister-ScheduledTask `
        -TaskName $script:PostRebootTaskName `
        -Confirm:$false `
        -ErrorAction SilentlyContinue
}

function Register-PromotionRebootTask {
    [CmdletBinding()]
    param ()

    $action = New-ScheduledTaskAction `
        -Execute "shutdown.exe" `
        -Argument "/r /t 0 /f"

    $trigger = New-ScheduledTaskTrigger `
        -Once `
        -At ((Get-Date).AddMinutes(2))

    $principal = New-ScheduledTaskPrincipal `
        -UserId "SYSTEM" `
        -LogonType ServiceAccount `
        -RunLevel Highest

    Register-ScheduledTask `
        -TaskName $script:RebootTaskName `
        -Action $action `
        -Trigger $trigger `
        -Principal $principal `
        -Force `
        -ErrorAction Stop | Out-Null
}

try {
    if (-not (Test-Path -LiteralPath $ProvisioningRoot)) {
        New-Item -ItemType Directory -Path $ProvisioningRoot -Force -ErrorAction Stop | Out-Null
    }

    Remove-Item -LiteralPath $FailureMarker -Force -ErrorAction SilentlyContinue

    Write-BootstrapLog -Message "Starting autonomous AD DS bootstrap."
    Write-BootstrapLog -Message "Computer: $env:COMPUTERNAME"
    Write-BootstrapLog -Message "Target forest: $DomainName"
    Write-BootstrapLog -Message "Target NetBIOS name: $DomainNetbiosName"
    Write-BootstrapLog -Message "Azure subscription: $SubscriptionId"

    # Idempotency: do not attempt to create the forest again if this server is
    # already a domain controller.
    $computerSystem = Get-CimInstance -ClassName Win32_ComputerSystem -ErrorAction Stop
    if ($computerSystem.DomainRole -in @(4, 5)) {
        Write-BootstrapLog -Message "Server is already a domain controller. Nothing to promote." -Level "SUCCESS"
        exit 0
    }

    if (-not (Test-Path -LiteralPath $DownloadedPostRebootScript -PathType Leaf)) {
        throw "Downloaded post-reboot script was not found: $DownloadedPostRebootScript"
    }

    if (-not (Test-Path -LiteralPath $DownloadedEnrollmentScript -PathType Leaf)) {
        throw "Downloaded Linux enrollment script was not found: $DownloadedEnrollmentScript"
    }

    Copy-Item -LiteralPath $DownloadedPostRebootScript -Destination $PostRebootScript -Force -ErrorAction Stop
    Copy-Item -LiteralPath $DownloadedEnrollmentScript -Destination $EnrollmentScript -Force -ErrorAction Stop
    Write-BootstrapLog -Message "Post-reboot scripts staged under '$ProvisioningRoot'." -Level "SUCCESS"

    # LinuxComputerEnrollment.ps1 declares #Requires for Az.Accounts and
    # Az.KeyVault. Install them before promotion so the SYSTEM continuation
    # task can resolve the modules immediately after reboot.
    Install-EnrollmentPrerequisites

    $feature = Get-WindowsFeature -Name AD-Domain-Services -ErrorAction Stop
    if (-not $feature.Installed) {
        Write-BootstrapLog -Message "Installing Active Directory Domain Services and management tools."
        $featureResult = Install-WindowsFeature -Name AD-Domain-Services -IncludeManagementTools -ErrorAction Stop

        if (-not $featureResult.Success) {
            throw "Install-WindowsFeature reported failure installing AD-Domain-Services."
        }
    }

    Import-Module ADDSDeployment -ErrorAction Stop
    Write-BootstrapLog -Message "AD-Domain-Services and ADDSDeployment are available." -Level "SUCCESS"

    # Retrieve the DSRM secret only when it is needed. Never log the value.
    $DsrmPassword = Get-DsrmPasswordWithRetry
    if ($DsrmPassword -eq "") {
        throw "DSRM password retrieval returned an empty value."
    }

    $SecureDsrmPassword = ConvertTo-SecureString -String $DsrmPassword -AsPlainText -Force

    Write-BootstrapLog -Message "Running new-forest prerequisite validation."
    Test-ADDSForestInstallation `
        -DomainName $DomainName `
        -DomainNetbiosName $DomainNetbiosName `
        -InstallDns `
        -SafeModeAdministratorPassword $SecureDsrmPassword `
        -NoRebootOnCompletion `
        -Force `
        -ErrorAction Stop

    Write-BootstrapLog -Message "Forest prerequisite validation passed." -Level "SUCCESS"

    # Arm Phase 2 before promotion so the continuation already exists when the
    # first post-promotion boot occurs.
    Register-PostRebootTask
    Write-BootstrapLog -Message "Post-reboot continuation task registered." -Level "SUCCESS"

    Write-BootstrapLog -Message "Creating forest '$DomainName' and promoting '$env:COMPUTERNAME' as its first domain controller."
    Install-ADDSForest `
        -DomainName $DomainName `
        -DomainNetbiosName $DomainNetbiosName `
        -InstallDns `
        -SafeModeAdministratorPassword $SecureDsrmPassword `
        -NoRebootOnCompletion `
        -Force `
        -ErrorAction Stop

    Write-BootstrapLog -Message "Install-ADDSForest completed successfully. Promotion reboot is required." -Level "SUCCESS"

    # Install-ADDSForest has completed the offline promotion work, but the new
    # DC role becomes active only after reboot. Confirm the promotion left the
    # expected AD DS artifacts before scheduling that reboot.
    if (-not (Test-Path -LiteralPath "$env:SystemRoot\NTDS")) {
        throw "AD DS promotion returned successfully, but the NTDS directory is missing."
    }

    if (-not (Test-Path -LiteralPath "$env:SystemRoot\SYSVOL")) {
        throw "AD DS promotion returned successfully, but the SYSVOL directory is missing."
    }

    @"
Computer=$env:COMPUTERNAME
Forest=$DomainName
NetBIOS=$DomainNetbiosName
Status=PromotionCompleted-RebootPending
Completed=$(Get-Date -Format "yyyy-MM-dd HH:mm:ss")
"@ | Set-Content -LiteralPath $Phase1Marker -Encoding UTF8 -Force

    # Release references to the plaintext password before the extension exits.
    $DsrmPassword = $null
    $SecureDsrmPassword = $null

    # Do not reboot from inside Install-ADDSForest. Give the Custom Script
    # Extension a clean success boundary, then reboot via a one-shot task.
    Register-PromotionRebootTask
    Write-BootstrapLog -Message "Promotion reboot scheduled. Phase 1 completed." -Level "SUCCESS"

    exit 0
}
catch {
    $errorMessage = $_.Exception.Message

    if (-not (Test-Path -LiteralPath $ProvisioningRoot)) {
        New-Item -ItemType Directory -Path $ProvisioningRoot -Force -ErrorAction SilentlyContinue | Out-Null
    }

    Write-BootstrapLog -Message "Bootstrap failed: $errorMessage" -Level "ERROR"

    @"
AD DS Phase 1 failed.
Computer=$env:COMPUTERNAME
Time=$(Get-Date -Format "yyyy-MM-dd HH:mm:ss")
Error=$errorMessage

Review:
$BootstrapLog
C:\Windows\debug\dcpromo.log
C:\Windows\debug\dcpromoui.log
"@ | Set-Content -LiteralPath $FailureMarker -Encoding UTF8 -Force

    # If forest creation failed before successful promotion, prevent the
    # post-reboot enrollment phase from running against a standalone server.
    $currentRole = $null
    try {
        $currentRole = (Get-CimInstance -ClassName Win32_ComputerSystem -ErrorAction Stop).DomainRole
    }
    catch {
    }

    if ($currentRole -notin @(4, 5)) {
        Remove-PostRebootTask
    }

    throw
}
finally {
    $DsrmPassword = $null
    $SecureDsrmPassword = $null
}
